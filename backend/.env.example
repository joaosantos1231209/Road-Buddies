DATABASE_URL="postgresql://user:password@host:port/database"
PORT=3000

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email provider: 'smtp' | 'sendgrid'
EMAIL_SENDER="smtp"

# SendGrid (fallback automático se o SMTP falhar)
SENDGRID_API_KEY="SG.your-key"

# SMTP (usado se EMAIL_SENDER=smtp)
SMTP_HOST="your-smtp-host"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# Remetente dos emails enviados pela plataforma
EMAIL_FROM_ADDRESS="noreply@loba.com"

# Email de destino/remetente para solicitações de viatura SP
SP_REQUEST_TO_EMAIL="gestor@empresa.pt"
SP_REQUEST_FROM_EMAIL="noreply@empresa.pt"

# Allowed emails besides @loba.com (comma-separated)
ALLOWED_EMAILS="user1@gmail.com, user2@gmail.com"

# Frontend origin for CORS (comma-separated for multiple)
FRONTEND_URL="http://localhost:5173"
